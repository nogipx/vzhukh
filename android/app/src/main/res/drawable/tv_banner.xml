<?xml version="1.0" encoding="utf-8"?>
<!-- Banner shown in the Android TV launcher (xhdpi 320x180 slot).
     Drawn as a layer-list so it scales cleanly instead of shipping a bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF07171C"
                android:endColor="#FF0E3B45" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
